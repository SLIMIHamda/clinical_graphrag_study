# Copy to .env (gitignored) and fill in. Never commit real keys.
#
# Every component is capability-detected, so the same file serves both profiles
# below: what you leave unset decides which implementation gets wired, and
# `python -m mgr.sweep --preflight-only` prints what was resolved before any run.

# ---------------------------------------------------------------------------
# Profile A — hosted (MIRAGE/MedQA; public corpora only)
# ---------------------------------------------------------------------------
# NIM free tier — embeddings / reranker / RAGAS judge / graph extraction.
# Generation NEVER goes to NIM (the NimClient.chat guard enforces that).
# Note the ~40 req/min ceiling: embedding a full corpus through it is weeks,
# which is why scripts/build_index.py exists.
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_API_KEY=

# ---------------------------------------------------------------------------
# Profile B — local / self-hosted (REQUIRED for credentialed chart data)
# ---------------------------------------------------------------------------
# Leave NIM_API_KEY EMPTY above. Every component then resolves locally and no
# text leaves the machine, which is what the PhysioNet DUA requires.

# Generation: "vllm" (HTTP server, default) or "hf_local" (in-process transformers)
GEN_BACKEND=vllm
VLLM_BASE_URL=http://localhost:8000
VLLM_API_KEY=
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
MAX_NEW_TOKENS=8

# Embeddings: "local" or "nim"; blank = local unless NIM_API_KEY is set.
# MedCPT is asymmetric — the query encoder is not the checkpoint the index was
# built with. build_index.py uses the article encoder; retrieval uses the query one.
EMB_BACKEND=
EMB_QUERY_MODEL=ncbi/MedCPT-Query-Encoder
EMB_DOC_MODEL=ncbi/MedCPT-Article-Encoder
EMB_BATCH_SIZE=64

# Reranker: "local" (default), "nim", or "none"
RERANK_BACKEND=local
RERANK_MODEL=ncbi/MedCPT-Cross-Encoder

# ---------------------------------------------------------------------------
# Data + built artifacts
# ---------------------------------------------------------------------------
DATA_ROOT=data
CORPUS=data/corpus.jsonl

# From scripts/build_index.py
DENSE_EMB=indices/corpus_emb.npy
DENSE_IDS=indices/corpus_ids.txt

# From `python -m mgr.graph.build_cli --store memory`. Without one of these the
# graph store dies with the build process and every graph/hybrid arm is unwired.
UMLS_DICT=
GRAPH_SNAPSHOT=results/graph_snapshot.json
GRAPH_HOPS=1
UMLS_FUZZY=0
# Alternative store (needs the [serve] extra + a running database):
NEO4J_URI=
NEO4J_PASSWORD=

# Frozen CARe gate (the P3 artifact). Adaptive rerank has no meaningful default,
# so leaving this unset does NOT fall back to always-rerank: Hybrid-CARRF-CARe is
# reported as unwired and skipped (or fails pre-flight under --strict).
CARE_GATE=

# ---------------------------------------------------------------------------
# Run shape
# ---------------------------------------------------------------------------
# Gate-A pre-retrieval capture. On by default and applied to the No-RAG arm only.
# Costs GATE_N_SAMPLES extra base passes per item, tracked separately as
# gate_cost_tokens so it never hides inside the No-RAG accuracy record.
# Turning this off leaves the Phase-A analysis with no features to read.
GATE_CAPTURE=1
GATE_N_SAMPLES=5
GATE_Q_EMB=0
RRF_K=60
N_ITEMS=
RESULTS_ROOT=results/local

# RunPod (infra/runpod scripts) — unused on a self-hosted box.
RUNPOD_API_KEY=
